{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals"],

    // Incremental migration: JS is allowed through but not yet type-checked.
    // Flip checkJs (or convert files to .ts) per-file as Phase 0 progresses.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tests", "vite.config.js"],
  "exclude": ["node_modules", "dist", "assets", "tools"]
}
