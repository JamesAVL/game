{
  "name": "mighty-boosh-zooniverse",
  "version": "1.0.0",
  "description": "The Mighty Boosh: Journey Through the Zooniverse - a pixel-art crimping adventure RPG.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:legacy": "node tools/serve.js",
    "assets": "python tools/gen_all.py",
    "validate": "node tools/validate_zones.mjs",
    "prebuild": "npm run assets && npm run validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "dependencies": {
    "three": "0.184.0"
  }
}
